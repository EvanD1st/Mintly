# Mintly Environment Configuration

# App
APP_ENV=development
APP_NAME=Mintly
APP_SECRET_KEY=change-this-in-production-use-a-strong-random-key
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=true

# Database
# For standalone local Windows development: sqlite+aiosqlite:///./mintly.db
# For Docker / production PostgreSQL: postgresql+asyncpg://mintly:mintly_secret@localhost:5432/mintly
DATABASE_URL=sqlite+aiosqlite:///./mintly.db

# Worker & Scheduling
WORKER_POLL_INTERVAL_SECONDS=120
WORKER_LEASE_DURATION_SECONDS=30
TIMEZONE=Africa/Lagos

# X / Twikit Discovery (Optional: if empty or invalid, falls back to manual import)
TWIKIT_USERNAME=
TWIKIT_EMAIL=
TWIKIT_PASSWORD=
TWIKIT_COOKIES_FILE=./cookies.json
X_MONITORED_USER=lakzonevn

# RPC Endpoints (EVM)
# Note: Use verified public or private RPCs for Base and Ethereum.
RPC_ETHEREUM=https://rpc.ankr.com/eth
RPC_BASE=https://mainnet.base.org
# Testnet RPC for safe execution verification
RPC_SEPOLIA=https://rpc.sepolia.org
RPC_BASE_SEPOLIA=https://sepolia.base.org

# OpenSea API (Optional: Rate-limited public endpoints used if empty)
OPENSEA_API_KEY=

# Signer Configuration
# Signer capability: demo | isolated_server_signer
SIGNER_MODE=demo
# Operator minting private key (HEX without 0x) for isolated testnet minting.
# WARNING: NEVER commit real keys or use Jenny's main wallet!
SIGNER_PRIVATE_KEY=

# Notifications
FIREBASE_CREDENTIALS_FILE=
ENABLE_LOCAL_NOTIFICATION_LOG=true
