# Explicit custody overlay, default Sepolia. Never put a private key/password value here.
CUSTODY_CHAIN_ID=11155111
ENABLE_ROBINHOOD_AUTOMATIC=false
# Keep task arming off while deploying/importing; this does not stop an existing worker.
CUSTODY_TASK_ARMING=false
# For a separately provisioned Robinhood deployment, use chain 4663 and its HTTPS
# endpoint as CUSTODY_RPC, with the separate opt-in true. No services are activated
# by this example. See docs/robinhood-signer-adapter.md.
CUSTODY_SEPOLIA_RPC=https://YOUR-VERIFIED-SEPOLIA-RPC
CUSTODY_VAULT_HOST_DIR=/srv/mintly-custody/vault
CUSTODY_PASSWORD_DIR=/srv/mintly-custody/password
CUSTODY_TOKEN_DIR=/srv/mintly-custody/token
CUSTODY_JOURNAL_DIR=/srv/mintly-custody/journal
# Also supply POSTGRES_PASSWORD, APP_SECRET_KEY and the normal authenticated app settings.
# The default deployment deliberately forces ENABLE_CUSTODIAL_AUTOMATIC=false.
